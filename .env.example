# Docker Compose settings (compose.yaml). Copy to .env. Never commit .env.
# The backend also reads this file when backend/.env does not set a value.

# Local PostgreSQL container used by `docker compose up`.
POSTGRES_DB=gopher_planner
POSTGRES_USER=gopher_planner
POSTGRES_PASSWORD=<local-database-password>

GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Build argument for the frontend image.
VITE_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
