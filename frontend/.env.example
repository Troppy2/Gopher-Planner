# Frontend settings. Copy to frontend/.env and fill in. Never commit frontend/.env.
# Every VITE_ value is built into the public bundle: never put secrets here.

# Same Google OAuth web client ID as the backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# Backend API base URL, including /api/v1. Leave it commented out: the dev server proxies /api to
# the backend and Docker/nginx serve /api on the same origin. Never set it to an empty value.
# VITE_API_URL=http://localhost:5000/api/v1
