# Backend settings. Copy to backend/.env and fill in. Never commit backend/.env.

# development or production. Production requires DATABASE_URL.
FLASK_ENVIRONMENT=development
PORT=5000

# Supabase PostgreSQL (Project Settings > Database > Connection string).
# Use the direct connection or the session pooler on port 5432, with the psycopg driver.
# Leave empty in development to use SQLite at backend/instance/dev.db.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Google OAuth web client ID (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# Exact browser origin of the frontend, no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# Long random value, for example: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<long-random-secret>

# true behind HTTPS in production.
COOKIE_SECURE=false

# Optional: directory of v2 program requirement files. Defaults to backend/data/programs.
# PROGRAM_DATA_PATH=

# Tests only: a disposable PostgreSQL database. Tests DROP its public schema.
# Never point this at Supabase.
# TEST_DATABASE_URL=postgresql+psycopg://gp:synthetic@localhost:55432/gp_test
