  {
   "id": "g-notes-programRequirements",
   "label": "Additional program requirements",
   "category": "Liberal ed",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "All degree-seeking students must complete the University's Liberal Education requirements .\nAll freshmen in the College of Science and Engineering must complete CSE 1001: First-Year Experience.\nIn addition to the core coursework, students will follow a professional astrophysics plan and complete the respective additional requirements, unless they opt into the secondary education sub-plan. These requirements are subject to departmental review for each student. If selected, the secondary education sub-plan needs to be added to the students program no later than the junior year.\nAt least half of upper division (3xxx level or higher) credits (20 cr.) that satisfy major requirements must be earned at the University of Minnesota Twin Cities campus.\nView\u00a0 Four-year Plans \u00a0for the College of Science and Engineering. Verify this requirement with your advisor or APAS."
   }
  },
