  {
   "id": "g-notes-programRequirements",
   "label": "Additional program requirements",
   "category": "Liberal ed",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "All degree-seeking students must complete the University's Liberal Education requirements .\nAt least half of the upper division credits required for the major must be taken at University of Minnesota Twin Cities (25 crs).\nA sample plan is available for this program at https://sampleplan.umn.edu/node/116 . Verify this requirement with your advisor or APAS."
   }
  },
  {
   "id": "g-notes-programAdmissionRequirements",
   "label": "Program admission requirements",
   "category": "Major core",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programAdmissionRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "Students with 30-49 transferable credits, GPA of 2.5, and strong interest in the major may be admitted to pre-major status.\nAdmission is based on GPA, grade trends, performance in relevant coursework, and demonstrated ability to meet expectations of individualized undergraduate education. Students must have attended an information session and an advising appointment.\nPreferred program match factors include:\nA 2-year break in pursuit of a degree (need not be continuous)\nA heavy, though not necessarily exclusive, reliance on evening and online/distance learning (ODL) coursework\nAt a timely point after admission, students must enroll in MDS 3001W: Intro to Multidisciplinary Studies, a 3-credit course, to develop a written proposal with a rationale for the degree plan. When the instructor has determined that the proposal is complete, it is submitted to a review committee for approval. At that point, the student achieves major status. Verify this requirement with your advisor or APAS."
   }
  }
