   "label": "Program admission requirements",
   "category": "Major core",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programAdmissionRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "Admission into the major is based on the following criteria:\n- Minimum 2.50 overall GPA; higher GPA is recommended.\n- Completion of all prerequisite courses listed below for University of Minnesota students. External transfer students entering the University of Minnesota Twin Cities must complete all transfer courses listed below except CI 1001; external transfer students entering the University of Minnesota Twin Cities may complete this course in the first semester of their program. Verify this requirement with your advisor or APAS."
   }
