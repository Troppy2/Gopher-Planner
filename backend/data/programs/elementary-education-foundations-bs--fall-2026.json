   "id": "g-notes-programRequirements",
   "label": "Additional program requirements",
   "category": "Liberal ed",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "All students must complete the University's Liberal Education requirements .\nDepartmental Requirements:\nThe only course that can be taken S/N is OLPD 4696.\nCollegiate Requirements:\nAt least 25 upper-division credits in the major must be taken at the University of Minnesota Twin Cities campus. Verify this requirement with your advisor or APAS."
   }
