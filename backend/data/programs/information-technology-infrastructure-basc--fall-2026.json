  {
   "id": "g-notes-programAdmissionRequirements",
   "label": "Program admission requirements",
   "category": "Major core",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programAdmissionRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "Students who have 30 or more transferable semester credits, preferred minimum 2.50 GPA, and successful completion of CSCI 1103 or 1113 or1133 or equivalent course may be admitted. In addition, relevant work experience in IT and/or a strong interest in the IT Infrastructure major may also strengthen a student\u2019s application. Each application for admission is individually reviewed holistically. For information about the University of Minnesota admission requirements, visit the Office of Admissions website. Verify this requirement with your advisor or APAS."
   }
  },
  {
   "id": "g-notes-programRequirements",
   "label": "Additional program requirements",
   "category": "Liberal ed",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "All degree-seeking students must complete the University's Liberal Education requirements .\nAt least half of the upper division credits required for the major must be taken at University of Minnesota Twin Cities (26 credits). Verify this requirement with your advisor or APAS."
   }
  },
  {
   "id": "g-sub-plans",
   "label": "Sub-plan requirements",
   "category": "Major core",
   "sourceRef": "program",
   "rule": {
    "id": "r-sub-plans",
    "type": "review",
    "sourceRef": "program",
    "message": "Complete any sub-plan requirements that apply to you: Applied Data Science, Machine Learning and Artificial Intelligence, DevSecOps and Project Management, Networking and Cloud Infrastructure, Cybersecurity and Governance, Self-Designed. Verify this requirement with your advisor or APAS."
   }
  }
