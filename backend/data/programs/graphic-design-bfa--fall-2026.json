  {
   "id": "g-notes-programAdmissionRequirements",
   "label": "Program admission requirements",
   "category": "Major core",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programAdmissionRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "Admission to pre-major status is decided by a competitive holistic review. Students must maintain an overall GPA of 2.50 during pre-major coursework. In addition, students must receive a minimum grade of C- or better in the required pre-major courses before going through portfolio review (not just a 2.50 GPA). Once students have achieved major status, they must maintain a GPA of 2.00.\nStudents must be admitted to pre-major status to take most of the pre-graphic design coursework. Verify this requirement with your advisor or APAS."
   }
  },
  {
   "id": "g-notes-programRequirements",
   "label": "Additional program requirements",
   "category": "Liberal ed",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "All degree-seeking students must complete the University\u2019s Liberal Education requirements .\nAt least 18 upper division credits in the major must be taken at the University of Minnesota Twin Cities campus. Verify this requirement with your advisor or APAS."
   }
  }
