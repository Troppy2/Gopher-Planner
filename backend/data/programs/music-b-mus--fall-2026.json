  {
   "id": "g-notes-programRequirements",
   "label": "Additional program requirements",
   "category": "Liberal ed",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "All students must complete the University's\u00a0 Liberal Education requirements.\nCollegiate Requirements:\nAll incoming CLA first-year (freshmen) must complete the First-Year Experience course sequence.\nAll students must complete a capstone in at least one CLA major. The requirements for double majors completing the capstone in a different CLA major will be clearly stated. Students must also complete all major requirements in both majors to allow the additional capstone to be waived. Students completing an additional degree must complete the Capstone in each degree area.\nStudents may earn no more than one undergraduate degree from the School of Music: a BA or a B.Mus or a minor. Students may earn more than one major within the B.Mus degree, but may not earn more than one emphasis within the BA degree.\nStudents are required to complete a sub-plan. Students may complete more than one sub-plan with prior approval from the School of Music. Note that an additional audition may be required.\nFor students in the Guitar, Harp, and Piano sub-plans, at least 24 upper-division credits in the major must be taken at the University of Minnesota Twin Cities campus.\nFor students in the Organ, and Voice sub-plans, at least 27 upper-division credits in the major must be taken at the University of Minnesota Twin Cities campus.\nFor students in the String, Woodwind, Brass, Percussion sub-plan, at least 26 upper-division credits in the major must be taken at the University of Minnesota Twin Cities campus. Verify this requirement with your advisor or APAS."
   }
  },
  {
   "id": "g-notes-programAdmissionRequirements",
   "label": "Program admission requirements",
   "category": "Major core",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programAdmissionRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "Admission to the B. Mus in performance is contingent upon passing an audition on a primary instrument. Auditions are highly competitive with students normally having studied their instrument with a one-on-one instructor for a number of years. Learn more about the School of Music application and audition requirements. Verify this requirement with your advisor or APAS."
   }
  },
  {
   "id": "g-sub-plans",
   "label": "Sub-plan requirements",
   "category": "Major core",
   "sourceRef": "program",
   "rule": {
    "id": "r-sub-plans",
    "type": "review",
    "sourceRef": "program",
    "message": "Complete any sub-plan requirements that apply to you: Classical Guitar, Harp, Organ, Piano, String, Woodwind, Brass, Percussion, Voice. Verify this requirement with your advisor or APAS."
   }
  }
