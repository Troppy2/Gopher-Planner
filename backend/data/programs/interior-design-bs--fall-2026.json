   "label": "Program admission requirements",
   "category": "Major core",
   "sourceRef": "program",
   "rule": {
    "id": "r-notes-programAdmissionRequirements",
    "type": "review",
    "sourceRef": "program",
    "message": "Admission to the pre-major status is done by a competitive holistic review. Students must maintain a GPA of 2.80 during pre-major coursework. In addition, students must receive a minimum grade of C- or better in the required pre-major courses before going through portfolio review (not just a 2.80 GPA). Once students have achieved major status, they must maintain a GPA of 2.00. Verify this requirement with your advisor or APAS."
   }
